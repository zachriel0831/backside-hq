@{
    Layout = "~/Views/Shared/_Backside.cshtml";
    ViewBag.Title = "公告";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
    
    <script src="~/Scripts/Backside/News.js"></script>
</head>
<body>
    <h2 style="text-align:center">公告</h2>
    <div id="table">
        <button class="btn" onclick="cInsert()">新增</button>
        <select id="DeptSelect">
            <option value=null>請選擇</option>
            <option value="msg">最新消息</option>
            <option value="link">網站連結</option>
            <option value="d_title">首頁每日頭條</option>
        </select>
        <table class="table">
            <thead>
                <tr class="title">
                    <th>維護</th>
                    <th>部門(主題區名稱)</th>
                    <th>資料型態</th>
                    <th>文章內容</th>
                    <th>文章圖片</th>
                    <th>文章連結</th>
                    <th>優先權</th>
                    <th>開始日期</th>
                    <th>結束日期</th>
                </tr>
            </thead>
            <tbody id="News_table"></tbody>
        </table>
    </div>
    <div id="input">

    </div>

</body>
</html>
