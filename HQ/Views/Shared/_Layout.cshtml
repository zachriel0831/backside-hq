@{
    var date = DateTime.Now.ToLongDateString();
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge, chrome=1" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/util")
    @Scripts.Render("~/Scripts/layout")
    @RenderSection("scripts", required: false)
    @*<script src="~/Scripts/Hq/Left_btn.js"></script>
        <script src="~/Scripts/Home/mm_menu.js"></script>*@
</head>
<body style="text-align:center">
    <div style="margin:0 auto; width:1024px">

        <table border="0" align="left" id="b_top" cellpadding="0" cellspacing="0" background="/images/bg_top.jpg">
            <tr>
                <td style=" width:990px ;height:76px" valign="top">
                    <table style=" width:990px ;height:76px" border="0" cellpadding="0">
                        <tr>
                            <td width="95%" align="right" scope="col">
                                <span class="fnt21">
                                    <font color="#FFFFFF" size="2" face="微軟正黑體">
                                        <a href="http://www.skm.com.tw/" target="_blank">新光三越</a>│
                                        <a href="http://www.skcineplex.com.tw/" target="_blank">新光影城</a>│
                                        <a href="http://www.fayaque.com.tw/" target="_blank">法雅客</a>
                                    </font>
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>

                        </tr>
                        <tr>
                            <td>&nbsp;</td>

                        </tr>
                        <tr>
                            <td style="float:right;color:black">@date</td>

                        </tr>
                    </table>
                </td>
            </tr>
        </table>
        <div id="left_btn" class="left">

            <div class="input-group mb-3" style="padding: 11px 0px 9px 2px;">
                <input type="text" class="form-control" placeholder="輸入姓名或電話" style="width:70%" id="tel_search" aria-describedby="basic-addon2">
                <div class="input-group-append">
                    <button class="btn btn-outline-secondary" onclick="onSearchTel()" type="button">搜尋</button>
                </div>
            </div>
        </div>
        <div class="main">

            <div>
                @RenderBody()
            </div>
            

            <footer></footer>
        </div>
    </div>
    <div class="col-md-12 down" align="center">
        著作權所有 新光三越百貨股份有限公司 資訊部
        <br />
        &copy; Copyright 2009 All Rights Reserved.
    </div>
    <script>
        function openForm() {
            document.getElementById("myForm").style.display = "block";
        }

        function closeForm() {
            document.getElementById("myForm").style.display = "none";
        }
    </script>
</body>
</html>
<link href="~/Content/css.css" rel="stylesheet" type="text/css">
<style type="text/css">
    #logoLayer {
        position: absolute;
        left: 0px;
        top: -1px;
        width: 128px;
        height: 75px;
        z-index: 1;
    }

    ul li {
        list-style-type: none;
        margin: 0px;
        padding: 0px;
    }

    .left {
        left: 0px;
        position: relative;
        min-height: 1px;
        padding-right: 15px;
        float: left;
        width: 212px;
    }

    .main {
        left: 0px;
        position: relative;
        min-height: 1px;
        float: left;
    }
    .lbtn {
        text-align: left;
        border-radius: 5px;
        width: 198px;
        height: 36px;
        background-color: white;
        border: 2px #FEE0C4 solid;
        font-weight:bold;
    }




</style>