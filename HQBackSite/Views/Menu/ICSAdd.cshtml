@model HQBackSite.Models.NewsModel
@{
    Layout = null;
}
<div class="modal-body p-2">
    @using (Html.BeginForm("ICSAdd", "Menu", FormMethod.Post, new { id = "addForm" }))
    {
        <div class="row mb-1">
            <div class="col-md-6">
                <label class="form-label" for="dept">公告類別</label>
                <select class="form-select" id="dept" name="dept" onchange="toggleICSFields(this)">
                    <option value="">請選擇</option>
                    <option value="上傳文件" @(Model.dept == "上傳文件" ? "selected" : "")>上傳文件</option>
                    <option value="資安文件" @(Model.dept == "資安文件" ? "selected" : "")>資安文件</option>
                    <option value="ISO文件" @(Model.dept == "ISO文件" ? "selected" : "")>ISO文件</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="background">公告名稱</label>
                @Html.TextBoxFor(m => m.background, new { @class = "form-control", id = "background", name = "background", maxlength = "200", placeholder = "請輸入標題" })
            </div>
        </div>
        <div class="row mb-1">
            <div class="col-md-6">
                <label class="form-label" for="start_date">起日</label>
                @Html.TextBoxFor(m => m.start_date, new { @class = "form-control", id = "start_date", name = "start_date", type = "date", placeholder = "請選擇起日" })
            </div>
            <div class="col-md-6">
                <label class="form-label" for="end_date">訖日</label>
                @Html.TextBoxFor(m => m.end_date, new { @class = "form-control", id = "end_date", name = "end_date", type = "date", placeholder = "請選擇訖日" })
            </div>
        </div>
        <div class="row mb-1" id="urlpathRow" style="display: none;">
            <div class="col-md-12">
                <label class="form-label" for="urlpath">
                    URL連結
                    <small class="text-muted">（可貼上連結或上傳檔案自動取得連結）</small>
                </label>
                <div class="input-group">
                    @Html.TextBoxFor(m => m.urlpath, new { @class = "form-control", id = "urlpath", name = "urlpath", placeholder = "請輸入URL連結或上傳檔案" })
                    <button type="button" class="btn btn-outline-secondary" id="uploadUrlpathBtn" onclick="document.getElementById('urlpathFileInput').click();">
                        <i class="fas fa-upload"></i> 上傳檔案
                    </button>
                    <input type="file" id="urlpathFileInput" style="display: none;" accept="*/*" onchange="handleUrlpathFileUpload(event)">
                </div>
            </div>
        </div>
        <div class="row mb-1" id="icsSecurityRow" style="display: none;">
            <div class="col-md-12">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label mb-0">資安文件</label>
                    <button type="button" class="btn btn-sm btn-primary" onclick="addIcsSecurityRow()">
                        <i class="fas fa-plus"></i> 新增
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm" id="icsSecurityTable">
                        <thead>
                            <tr>
                                <th style="width: 20%;">類別</th>
                                <th style="width: 40%;">內容</th>
                                <th style="width: 30%;">檔案名稱</th>
                                <th style="width: 10%;">操作</th>
                            </tr>
                        </thead>
                        <tbody id="icsSecurityTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="row mb-1" id="icsIsoRow" style="display: none;">
            <div class="col-md-12">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label mb-0">ISO文件</label>
                    <button type="button" class="btn btn-sm btn-primary" onclick="addIcsIsoRow()">
                        <i class="fas fa-plus"></i> 新增
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm" id="icsIsoTable">
                        <thead>
                            <tr>
                                <th style="width: 10%;">序號</th>
                                <th style="width: 15%;">文件編號</th>
                                <th style="width: 20%;">文件名稱</th>
                                <th style="width: 20%;">相關文件（附件及表單）</th>
                                <th style="width: 15%;">文件負責人</th>
                                <th style="width: 15%;">備註</th>
                                <th style="width: 5%;">操作</th>
                            </tr>
                        </thead>
                        <tbody id="icsIsoTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
    <button type="button" class="btn btn-primary" onclick="submitAddForm()">確定</button>
</div>
<script src="~/Scripts/content.js"></script>
<script>
    function toggleICSFields(ts) {

        var dept = ts.value

        var urlpathRow = document.getElementById('urlpathRow');
        var icsSecurityRow = document.getElementById('icsSecurityRow');
        var icsIsoRow = document.getElementById('icsIsoRow');

        urlpathRow.style.display = 'none';
        icsSecurityRow.style.display = 'none';
        icsIsoRow.style.display = 'none';

        if (dept === '上傳文件') urlpathRow.style.display = 'block';
        else if (dept === '資安文件') icsSecurityRow.style.display = 'block';
        else if (dept === 'ISO文件') icsIsoRow.style.display = 'block';
    }

    async function handleUrlpathFileUpload(event) {
        var file = event.target.files[0];
        if (!file) return;

        var formData = new FormData();
        formData.append('file', file);
        var uploadBtn = document.getElementById('uploadUrlpathBtn');
        var originalText = uploadBtn.innerHTML;
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 上傳中...';

        try {
            var response = await fetch('/Menu/UploadFileForUrl', { method: 'POST', body: formData });
            var result = await response.json();
            if (result.code === 1 && result.data && result.data.url) {
                var urlpathInput = document.getElementById('urlpath');
                if (urlpathInput) urlpathInput.value = result.data.url;
            } else {
                alert(result.message || '上傳失敗');
            }
        } catch (error) {
            alert('上傳失敗：' + error.message);
        } finally {
            uploadBtn.disabled = false;
            uploadBtn.innerHTML = originalText;
            event.target.value = '';
        }
    }

    // 資安文件表格相關函數
    var icsSecurityRowIndex = 0;
    function addIcsSecurityRow() {
        var tbody = document.getElementById('icsSecurityTableBody');
        if (!tbody) return;

        var row = document.createElement('tr');
        row.setAttribute('data-index', icsSecurityRowIndex);
        row.innerHTML = `
            <td><input type="text" class="form-control form-control-sm" name="icsSecurity[${icsSecurityRowIndex}].Category" placeholder="類別"></td>
            <td><input type="text" class="form-control form-control-sm" name="icsSecurity[${icsSecurityRowIndex}].Content" placeholder="內容"></td>
            <td>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control" name="icsSecurity[${icsSecurityRowIndex}].FileName" placeholder="檔案名稱" readonly>
                    <button type="button" class="btn btn-outline-secondary" onclick="uploadFileForIcsSecurity(${icsSecurityRowIndex})">
                        <i class="fas fa-upload"></i>
                    </button>
                    <input type="file" id="icsSecurityFile_${icsSecurityRowIndex}" style="display: none;" accept="*/*" onchange="handleIcsSecurityFileUpload(event, ${icsSecurityRowIndex})">
                </div>
            </td>
            <td>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeIcsSecurityRow(${icsSecurityRowIndex})">
                    <i class="fas fa-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(row);
        icsSecurityRowIndex++;
    }

    function removeIcsSecurityRow(index) {
        var row = document.querySelector(`#icsSecurityTableBody tr[data-index="${index}"]`);
        if (row) row.remove();
    }

    function uploadFileForIcsSecurity(index) {
        var fileInput = document.getElementById(`icsSecurityFile_${index}`);
        if (fileInput) fileInput.click();
    }

    async function handleIcsSecurityFileUpload(event, index) {
        var file = event.target.files[0];
        if (!file) return;

        var formData = new FormData();
        formData.append('file', file);

        try {
            var response = await fetch('/Menu/UploadFileForUrl', { method: 'POST', body: formData });
            var result = await response.json();
            if (result.code === 1 && result.data && result.data.url) {
                var row = document.querySelector(`#icsSecurityTableBody tr[data-index="${index}"]`);
                if (row) {
                    var fileNameInput = row.querySelector('input[name*="FileName"]');
                    if (fileNameInput) fileNameInput.value = file.name;
                    var urlInput = row.querySelector('input[name*="DocUrl"]');
                    if (!urlInput) {
                        urlInput = document.createElement('input');
                        urlInput.type = 'hidden';
                        urlInput.name = `icsSecurity[${index}].DocUrl`;
                        row.appendChild(urlInput);
                    }
                    urlInput.value = result.data.url;
                }
            } else {
                alert(result.message || '上傳失敗');
            }
        } catch (error) {
            alert('上傳失敗：' + error.message);
        } finally {
            event.target.value = '';
        }
    }

    // ISO文件表格相關函數
    var icsIsoRowIndex = 0;
    function addIcsIsoRow() {
        var tbody = document.getElementById('icsIsoTableBody');
        if (!tbody) return;

        var row = document.createElement('tr');
        row.setAttribute('data-index', icsIsoRowIndex);
        row.innerHTML = `
            <td><input type="text" class="form-control form-control-sm" name="icsIso[${icsIsoRowIndex}].SerialNumber" placeholder="序號"></td>
            <td><input type="text" class="form-control form-control-sm" name="icsIso[${icsIsoRowIndex}].DocNo" placeholder="文件編號"></td>
            <td><input type="text" class="form-control form-control-sm" name="icsIso[${icsIsoRowIndex}].DocName" placeholder="文件名稱"></td>
            <td>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control" name="icsIso[${icsIsoRowIndex}].AttachmentInfo" placeholder="相關文件" readonly>
                    <button type="button" class="btn btn-outline-secondary" onclick="uploadFileForIcsIso(${icsIsoRowIndex})">
                        <i class="fas fa-upload"></i>
                    </button>
                    <input type="file" id="icsIsoFile_${icsIsoRowIndex}" style="display: none;" accept="*/*" onchange="handleIcsIsoFileUpload(event, ${icsIsoRowIndex})">
                </div>
            </td>
            <td><input type="text" class="form-control form-control-sm" name="icsIso[${icsIsoRowIndex}].MainUser" placeholder="文件負責人"></td>
            <td><input type="text" class="form-control form-control-sm" name="icsIso[${icsIsoRowIndex}].Remark" placeholder="備註"></td>
            <td>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeIcsIsoRow(${icsIsoRowIndex})">
                    <i class="fas fa-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(row);
        icsIsoRowIndex++;
    }

    function removeIcsIsoRow(index) {
        var row = document.querySelector(`#icsIsoTableBody tr[data-index="${index}"]`);
        if (row) row.remove();
    }

    function uploadFileForIcsIso(index) {
        var fileInput = document.getElementById(`icsIsoFile_${index}`);
        if (fileInput) fileInput.click();
    }

    async function handleIcsIsoFileUpload(event, index) {
        var file = event.target.files[0];
        if (!file) return;

        var formData = new FormData();
        formData.append('file', file);

        try {
            var response = await fetch('/Menu/UploadFileForUrl', { method: 'POST', body: formData });
            var result = await response.json();
            if (result.code === 1 && result.data && result.data.url) {
                var row = document.querySelector(`#icsIsoTableBody tr[data-index="${index}"]`);
                if (row) {
                    var attachmentInput = row.querySelector('input[name*="AttachmentInfo"]');
                    if (attachmentInput) attachmentInput.value = file.name;
                    var urlInput = row.querySelector('input[name*="DocUrl"]');
                    if (!urlInput) {
                        urlInput = document.createElement('input');
                        urlInput.type = 'hidden';
                        urlInput.name = `icsIso[${index}].DocUrl`;
                        row.appendChild(urlInput);
                    }
                    urlInput.value = result.data.url;
                }
            } else {
                alert(result.message || '上傳失敗');
            }
        } catch (error) {
            alert('上傳失敗：' + error.message);
        } finally {
            event.target.value = '';
        }
    }

    // 表單提交
    async function submitAddForm() {
        var form = document.getElementById('addForm');
        if (!form) {
            alert('表單不存在');
            return;
        }

        var formData = new FormData(form);

        // 收集資安文件資料
        var icsSecurityData = [];
        document.querySelectorAll('#icsSecurityTableBody tr').forEach(function (row) {
            var category = row.querySelector('input[name*="Category"]')?.value || '';
            var content = row.querySelector('input[name*="Content"]')?.value || '';
            var fileName = row.querySelector('input[name*="FileName"]')?.value || '';
            var docUrl = row.querySelector('input[name*="DocUrl"]')?.value || '';
            if (category || content || fileName) {
                icsSecurityData.push({ Category: category, Content: content, FileName: fileName, DocUrl: docUrl });
            }
        });

        // 收集 ISO 文件資料
        var icsIsoData = [];
        document.querySelectorAll('#icsIsoTableBody tr').forEach(function (row) {
            var serialNumber = row.querySelector('input[name*="SerialNumber"]')?.value || '';
            var docNo = row.querySelector('input[name*="DocNo"]')?.value || '';
            var docName = row.querySelector('input[name*="DocName"]')?.value || '';
            var attachmentInfo = row.querySelector('input[name*="AttachmentInfo"]')?.value || '';
            var docUrl = row.querySelector('input[name*="DocUrl"]')?.value || '';
            var mainUser = row.querySelector('input[name*="MainUser"]')?.value || '';
            var remark = row.querySelector('input[name*="Remark"]')?.value || '';
            if (serialNumber || docNo || docName || attachmentInfo || mainUser || remark) {
                icsIsoData.push({
                    SerialNumber: serialNumber, DocNo: docNo, DocName: docName,
                    AttachmentInfo: attachmentInfo, DocUrl: docUrl, MainUser: mainUser, Remark: remark
                });
            }
        });

        var data = Object.fromEntries(formData);
        data.icsSecurityData = JSON.stringify(icsSecurityData);
        data.icsIsoData = JSON.stringify(icsIsoData);

        try {
            var result = await libs.api.post('/Menu/ICSAdd', { data: data, loadding: true });
            libs.result(result, function () {
                if (typeof query === 'function') query();
                libs.modal.closeModal();
            });
        } catch (error) {
            alert('提交失敗：' + (error.message || '未知錯誤'));
        }
    }
</script>
