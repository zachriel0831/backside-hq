@model HQBackSite.Models.PagedListModel<HQBackSite.Models.NewsModel>
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>訊息編號</th>
                        <th>訊息類別</th>
                        <th>訊息名稱</th>
                        <th>起訖日</th>
                        <th>優先權</th>
                        <th>上下線狀態</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>
                        <td style="width:8%">@item.des_no</td>
                        <td style="width:10%">@item.dept</td>
                        <td style="width:18%">@item.background</td>
                        <td style="width:18%">
                            @(item.start_date.HasValue ? item.start_date.Value.ToString("yyyy-MM-dd") : "")
                            ~
                            @(item.end_date.HasValue ? item.end_date.Value.ToString("yyyy-MM-dd") : "")
                        </td>
                        <td style="width:8%">@item.priority</td>
                        <td style="width:10%">
                            @if (item.status == "上線")
                            {
                                <span>上線</span>
                            }
                            else
                            {
                                <span style="color: red;">下線</span>
                            }
                        </td>
                        <td style="width:10%">
                            <button class="btn btn-sm btn-outline-primary me-1" onclick="libs.modal.openModalL('編輯', '/Menu/MessageUpdate?des_no=@item.des_no')">編輯</button>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@{ Html.RenderPartial("_Pager", new HQBackSite.Models.PagerModel("MessageQuery", Model, ViewBag.QueryModel)); }
