@model HQBackSite.Models.PagerModel
@using System

@if (Model.PagedList.TotalPages > 1)
{
    <div class="card mt-2">
        <div class="card-body" style="padding: 1em 1.5em 0 1.5em;">
            <div class="row">
                <div class="col-sm-12 col-md-12">
                    <div class="dataTables_paginate">
                        <ul class="pagination" style="float: left;">
                            @if (Model.PagedList.HasPreviousPage)
                            {
                                <li class="paginate_button page-item">
                                    <a href="javascript:void(0)" class="page-link" onclick="pagerGoToPage(1)">
                                        <i class="fas fa-angle-double-left"></i>
                                    </a>
                                </li>
                                <li class="paginate_button page-item">
                                    <a href="javascript:void(0);" class="page-link" onclick="pagerGoToPage(@(Model.PagedList.PageNo - 1))">
                                        <i class="fas fa-angle-left"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="paginate_button page-item disabled">
                                    <a href="javascript:void(0)" class="page-link">
                                        <i class="fas fa-angle-double-left"></i>
                                    </a>
                                </li>
                                <li class="paginate_button page-item disabled">
                                    <a href="javascript:void(0);" class="page-link">
                                        <i class="fas fa-angle-left"></i>
                                    </a>
                                </li>
                            }

                            @{
                                int currentPage = Model.PagedList.PageNo;
                                int totalPages = Model.PagedList.TotalPages;
                                int startPage = 1;
                                int endPage = Math.Min(5, totalPages);
                                
                                if (currentPage > 3 && totalPages > 5)
                                {
                                    if (currentPage + 2 <= totalPages)
                                    {
                                        startPage = currentPage - 2;
                                        endPage = currentPage + 2;
                                    }
                                    else
                                    {
                                        startPage = Math.Max(1, totalPages - 4);
                                        endPage = totalPages;
                                    }
                                }
                                
                                for (int i = startPage; i <= endPage; i++)
                                {
                                    <li class="paginate_button page-item @(i == currentPage ? "active" : "")">
                                        <a href="javascript:void(0);" class="page-link" onclick="pagerGoToPage(@i)">@i</a>
                                    </li>
                                }
                            }

                            @if (Model.PagedList.HasNextPage)
                            {
                                <li class="paginate_button page-item">
                                    <a href="javascript:void(0);" class="page-link" onclick="pagerGoToPage(@(Model.PagedList.PageNo + 1))">
                                        <i class="fas fa-angle-right"></i>
                                    </a>
                                </li>
                                <li class="paginate_button page-item">
                                    <a href="javascript:void(0)" class="page-link" onclick="pagerGoToPage(@Model.PagedList.TotalPages)">
                                        <i class="fas fa-angle-double-right"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="paginate_button page-item disabled">
                                    <a href="javascript:void(0);" class="page-link">
                                        <i class="fas fa-angle-right"></i>
                                    </a>
                                </li>
                                <li class="paginate_button page-item disabled">
                                    <a href="javascript:void(0)" class="page-link">
                                        <i class="fas fa-angle-double-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                        <div class="d-none d-sm-inline" style="float: right; margin-top: 0.45em; font-size: 12px;">
                            顯示 @(((Model.PagedList.PageNo - 1) * Model.PagedList.PageSize) + 1) 至 @(Math.Min(Model.PagedList.PageNo * Model.PagedList.PageSize, Model.PagedList.TotalCount)) 筆，共 @Model.PagedList.TotalCount 筆
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
